let answers = [];
let score = 0;
let multiSelections = [];
let startTime = null;
let timerInterval = null;
let elapsedSeconds = 0;

function showView(id) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function formatTime(s) {
  const m = Math.floor(s / 60).toString().padStart(2, '0');
  const sec = (s % 60).toString().padStart(2, '0');
  return `${m}:${sec}`;
}

function startTimer() {
  startTime = Date.now();
  elapsedSeconds = 0;
  timerInterval = setInterval(() => {
    elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
    document.getElementById('timer').textContent = formatTime(elapsedSeconds);
  }, 1000);
}

function stopTimer() {
  if (timerInterval) {
    clearInterval(timerInterval);
    timerInterval = null;
  }
}

function startQuiz() {
  currentQ = 0;
  answers = [];
  score = 0;
  multiSelections = [];
  showView('quiz-body');
  renderProgressDots();
  renderQuestion();
  startTimer();
}

function restartQuiz() {
  showView('quiz-intro');
}

function renderProgressDots() {
  const dots = document.getElementById('progress-dots');
  dots.innerHTML = '';
  for (let i = 0; i < quizData.length; i++) {
    const d = document.createElement('div');
    d.className = 'progress-dot';
    if (i < currentQ) d.classList.add('done');
    if (i === currentQ) d.classList.add('active');
    dots.appendChild(d);
  }
  document.getElementById('progress-bar').style.width = `${(currentQ / quizData.length) * 100}%`;
  document.getElementById('q-current').textContent = currentQ + 1;
}

function renderQuestion() {
  const q = quizData[currentQ];
  const isMulti = q.type === 'multi';
  const c = document.getElementById('quiz-content');

  let html = `
    <div class="mb-2 eyebrow">${q.chapter}</div>
    <h2 class="font-serif-tc font-bold text-2xl md:text-3xl mb-3">${q.title}</h2>
    <p class="text-base mb-8" style="color: #555;">${q.instruction}</p>
    <div class="space-y-3" id="options-wrap">
  `;

  q.options.forEach((opt, i) => {
    const letter = String.fromCharCode(65 + i);
    html += `
      <button class="quiz-option" data-idx="${i}" onclick="${isMulti ? `toggleMulti(${i})` : `selectSingle(${i})`}">
        <div class="option-letter">${letter}</div>
        <div class="flex-1" style="padding-top: 4px;">${opt}</div>
      </button>
    `;
  });

  html += `</div>`;

  if (isMulti) {
    html += `
      <div class="mt-6 flex justify-end">
        <button class="btn-primary" id="submit-multi" onclick="submitMulti()">提交答案
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>
      </div>
    `;
  }

  html += `<div id="feedback-slot"></div>`;
  c.innerHTML = html;
}

function toggleMulti(i) {
  const btn = document.querySelector(`#options-wrap [data-idx="${i}"]`);
  if (btn.classList.contains('disabled')) return;
  const idx = multiSelections.indexOf(i);
  if (idx >= 0) {
    multiSelections.splice(idx, 1);
    btn.classList.remove('selected');
  } else {
    multiSelections.push(i);
    btn.classList.add('selected');
  }
}

function submitMulti() {
  const q = quizData[currentQ];
  const correctSet = new Set(q.correct);
  const userSet = new Set(multiSelections);

  document.querySelectorAll('#options-wrap .quiz-option').forEach((btn) => {
    btn.classList.add('disabled');
    const i = parseInt(btn.dataset.idx);
    if (correctSet.has(i) && userSet.has(i)) btn.classList.add('correct');
    else if (correctSet.has(i) && !userSet.has(i)) btn.classList.add('correct');
    else if (!correctSet.has(i) && userSet.has(i)) btn.classList.add('wrong');
  });

  document.getElementById('submit-multi').remove();

  const isPerfect = correctSet.size === userSet.size && [...correctSet].every(x => userSet.has(x));
  answers.push(isPerfect);
  if (isPerfect) score++;
  multiSelections = [];

  showFeedback(isPerfect);
}

function selectSingle(i) {
  const q = quizData[currentQ];
  const isCorrect = i === q.correct;
  answers.push(isCorrect);
  if (isCorrect) score++;

  document.querySelectorAll('#options-wrap .quiz-option').forEach((btn) => {
    btn.classList.add('disabled');
    const idx = parseInt(btn.dataset.idx);
    if (idx === q.correct) btn.classList.add('correct');
    if (idx === i && i !== q.correct) btn.classList.add('wrong');
    btn.onclick = null;
  });

  showFeedback(isCorrect);
}

function showFeedback(isCorrect) {
  const q = quizData[currentQ];
  const slot = document.getElementById('feedback-slot');
  const isLast = currentQ === quizData.length - 1;
  const points = q.explanation.points.map(p => `<li class="flex gap-3 items-start mb-2"><span style="color: var(--moss-deep); font-weight: bold; flex-shrink: 0;">·</span><span>${p}</span></li>`).join('');

  slot.innerHTML = `
    <div class="feedback ${isCorrect ? 'success' : 'error'}">
      <div class="flex items-center gap-3 mb-3">
        ${isCorrect
          ? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2d5f4f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
             <div class="font-serif-tc font-bold text-lg" style="color: var(--moss-deep);">答對了！</div>`
          : `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#b33a3a" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
             <div class="font-serif-tc font-bold text-lg" style="color: var(--rose);">再複習一下！</div>`
        }
      </div>
      <div class="font-medium mb-3" style="color: var(--ink);">${q.explanation.title}</div>
      <ul class="text-sm" style="color: #444; line-height: 1.7;">${points}</ul>
    </div>
    <div class="mt-6 flex justify-end">
      <button class="btn-primary" onclick="${isLast ? 'finishQuiz()' : 'nextQuestion()'}">
        ${isLast ? '查看結果' : '下一題'}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </button>
    </div>
  `;
}

function nextQuestion() {
  currentQ++;
  renderProgressDots();
  renderQuestion();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function finishQuiz() {
  stopTimer();
  showView('quiz-finish');

  // Animate score
  const finalEl = document.getElementById('final-score');
  let n = 0;
  const target = score;
  if (target === 0) {
    finalEl.textContent = '0';
  } else {
    const interval = setInterval(() => {
      n++;
      finalEl.textContent = n;
      if (n >= target) clearInterval(interval);
    }, 180);
  }

  // Show total time
  document.getElementById('final-time').textContent = formatTime(elapsedSeconds);

  // Comment
  const commentEl = document.getElementById('score-comment');
  if (score === 6) commentEl.textContent = '滿分！您已掌握每一個關鍵環節。';
  else if (score >= 4) commentEl.textContent = '不錯的表現，再複習一次錯題就更完整了。';
  else commentEl.textContent = '建議回到學習平台複習教材後，再來挑戰。';
}
</script>

</body>
</html>
