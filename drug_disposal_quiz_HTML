<!DOCTYPE html>
<html lang="zh-Hant"><head><meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>藥品保存與丟棄衛教練習</title>
<style>
  body {
    margin: 0;
    background: #FAF8F4;
    color: #1F3A33;
    font-family: "Microsoft JhengHei", "Noto Sans TC", sans-serif;
    padding: 32px 20px;
  }

  .quiz-wrap {
    max-width: 720px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 20px;
    color: #1F3A33;
    line-height: 1.6;
    text-align: center;
  }

  .progress {
    font-size: 13px;
    color: #5C6B66;
    margin: 0 0 4px;
    font-weight: 500;
    text-align: center;
  }

  .timer {
    font-size: 13px;
    color: #5C6B66;
    margin: 0 0 16px;
    font-weight: 500;
    text-align: center;
    letter-spacing: 0.5px;
  }

  .timer-final {
    font-size: 16px;
    font-weight: 700;
    color: #1F3A33;
    margin: 4px 0 0;
  }

  .quiz-card {
    background: #FFFFFF;
    border: 1px solid #E7E2D8;
    border-radius: 16px;
    padding: 28px 28px 24px;
  }

  .sentence {
    font-size: 16px;
    line-height: 2.6;
    margin: 0 0 6px;
    color: #1F3A33;
  }

  .blank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 90px;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    vertical-align: middle;
    margin: 0 4px;
    transition: background 0.15s ease;
  }

  .blank-empty {
    border: 1.5px dashed #C9C2B4;
    background: #FAF8F4;
    color: #A8A096;
  }

  .blank-filled {
    border: 1.5px solid #5C8AA6;
    background: #EAF1F5;
    color: #2D5670;
  }

  .blank-correct {
    border: 1.5px solid #5B8C6B;
    background: #EBF4EC;
    color: #3A6B47;
  }

  .blank-wrong {
    border: 1.5px solid #D97B4F;
    background: #FBEAE1;
    color: #B8542A;
  }

  .options-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid #E7E2D8;
  }

  .option-btn {
    font-family: inherit;
    border: 1px solid #E7E2D8;
    background: #FFFFFF;
    color: #1F3A33;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.1s ease;
  }

  .option-btn:hover:not(:disabled) {
    border-color: #D97B4F;
    transform: translateY(-1px);
  }

  .option-btn:disabled {
    cursor: default;
  }

  .footer-row {
    margin-top: 24px;
  }

  .check-btn {
    font-family: inherit;
    display: block;
    margin-left: auto;
    border: 1px solid #1F3A33;
    background: #1F3A33;
    color: #fff;
    padding: 10px 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .check-btn:hover:not(:disabled) {
    background: #D97B4F;
    border-color: #D97B4F;
  }

  .check-btn:disabled {
    background: #C9C2B4;
    border-color: #C9C2B4;
    cursor: default;
  }

  .result-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .result-success {
    background: #EBF4EC;
    color: #3A6B47;
  }

  .result-danger {
    background: #FBEAE1;
    color: #B8542A;
  }

  .retry-btn {
    font-family: inherit;
    flex-shrink: 0;
    border: 1px solid #D97B4F;
    background: #fff;
    color: #D97B4F;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .retry-btn:hover {
    background: #D97B4F;
    color: #fff;
  }

  .finish-banner {
    text-align: center;
    padding: 40px 20px;
  }

  .finish-banner .big {
    font-size: 20px;
    font-weight: 700;
    color: #1F3A33;
    margin-bottom: 8px;
  }

  .finish-banner .small {
    font-size: 14px;
    color: #5C6B66;
  }

  .back-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 700;
    color: #5C8AA6;
    text-decoration: none;
    border-bottom: 1px solid #5C8AA6;
    padding-bottom: 2px;
  }

  .back-link:hover {
    color: #D97B4F;
    border-bottom-color: #D97B4F;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
  }
</style>
</head>
<body>

<div class="quiz-wrap">
  <div class="quiz-card">
    <div id="quiz-root">
      <p class="progress">載入中...</p>
    </div>
  </div>
</div>

<script>
(function(){
  const pages = [
    {
      title: "藥品保存的「三防三不」原則",
      groups: [
        {
          segments: [
            "藥品保存要注意「三防」，分別是防高溫、防潮濕、防",
            "GAP",
            "。一般藥物除非藥袋標示需",
            "GAP",
            "，否則不建議放入冰箱，因為內部濕度過高，反而會加速藥物受潮變質。",
            "GAP",
            "也不適合存放藥品，原因是這兩處的溫濕度變化太劇烈。另外應盡量保留原本的藥品原包裝與完整藥袋，不要提早把藥品分裝，以免藥品混淆或受潮。"
          ],
          answers: ["光線直射", "冷藏", "浴室與廚房"]
        }
      ],
      distractors: ["冷凍", "客廳與臥室", "塑膠袋", "提前", "保鮮膜"]
    },
    {
      title: "特殊藥品回收指南",
      groups: [
        {
          segments: [
            "有多項藥品用畢或過期後，必須送回醫院或藥局的廢棄藥品檢收箱，不可隨意丟棄，包括",
            "GAP", "、",
            "GAP", "、",
            "GAP", "、",
            "GAP", "、",
            "GAP", "，以及",
            "GAP",
            "。其中針具與針頭需要裝入",
            "GAP",
            "容器中再送回，這樣做的目的是避免造成環境賀爾蒙污染，以及防止藥物遭到濫用。"
          ],
          answers: ["抗生素", "荷爾蒙藥物", "抗癌化療藥", "免疫抑制劑", "管制藥品", "針具與針頭", "堅硬"]
        }
      ],
      distractors: ["止痛藥", "維生素", "感冒藥", "消炎藥", "保健食品", "軟質", "輕薄", "塑膠", "紙箱", "過期藥"]
    },
    {
      title: "一般藥品丟棄四步驟",
      groups: [
        {
          segments: [
            "一般藥品丟棄共有四個步驟。第一步是「倒」，將剩餘的藥水或藥丸倒入",
            "GAP",
            "中；第二步是「沖」，用水稍微沖洗藥水罐，沖洗水也一併倒入袋中；第三步是「吸」，放入咖啡渣、茶葉或用過的",
            "GAP",
            "，目的是吸收液體並掩蓋藥物外觀；第四步是「封」，將夾鏈袋密封好後丟入一般垃圾桶，而空瓶與紙盒則應進行",
            "GAP",
            "。這四個步驟的核心觀念是阻絕污染、破壞外觀，並讓藥物隨一般垃圾高溫",
            "GAP",
            "。"
          ],
          answers: ["夾鏈袋", "衛生紙", "資源回收", "焚化"]
        }
      ],
      distractors: ["垃圾袋", "保鮮膜", "廢紙", "棉花", "掩埋", "冷凍保存"]
    },
    {
      title: "常見迷思 Q&A",
      groups: [
        {
          segments: [
            "有些人認為藥品怕壞掉，所以全部塞進冰箱最安全，但這個說法並不正確，因為冰箱濕度很高，只有特別註明需冷藏、溫度介於2到8度的藥品，例如未開封的",
            "GAP",
            "，才需要放冰箱。也有人以為感冒喝剩的咳嗽藥水可以直接倒進水槽或馬桶沖掉，這樣做其實會造成環境與水源污染。隨意丟棄管制性藥品有遭到",
            "GAP",
            "與濫用的風險，必須拿回醫院或藥局的檢收箱回收。"
          ],
          answers: ["胰島素", "撿拾"]
        }
      ],
      distractors: ["維生素", "吸入劑", "眼藥水", "丟棄"]
    }
  ];

  let pageIndex = 0;
  let options = [];
  let filled = {};
  let checked = false;
  let elapsedSeconds = 0;
  let timerInterval = null;

  function shuffle(arr){
    const a = arr.slice();
    for(let i=a.length-1;i>0;i--){
      const j = Math.floor(Math.random()*(i+1));
      [a[i],a[j]] = [a[j],a[i]];
    }
    return a;
  }

  function formatTime(totalSeconds){
    const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
    const s = (totalSeconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function startTimer(){
    if(timerInterval) return; // 已經在跑了，不重複啟動
    timerInterval = setInterval(() => {
      elapsedSeconds++;
      const el = document.getElementById('quiz-timer');
      if(el) el.textContent = `已花費時間：${formatTime(elapsedSeconds)}`;
    }, 1000);
  }

  function stopTimer(){
    if(timerInterval){
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  function initPage(){
    const page = pages[pageIndex];
    const flatBlanks = getFlatBlanks(page);
    options = shuffle(flatBlanks.map(b=>b.answer).concat(page.distractors));
    filled = {};
    checked = false;
    render();
    startTimer();
  }

  function getFlatBlanks(page){
    // 把所有 group 裡的答案展平成一個全域列表，每個空格記錄所屬 group
    const flat = [];
    page.groups.forEach((g, gi) => {
      g.answers.forEach((ans, ai) => {
        flat.push({ groupIndex: gi, answerIndexInGroup: ai, answer: ans });
      });
    });
    return flat;
  }

  function selectOption(opt){
    if(checked) return;
    const page = pages[pageIndex];
    const flatBlanks = getFlatBlanks(page);
    if(Object.values(filled).includes(opt)) return;
    const emptyIdx = flatBlanks.findIndex((b, i) => !filled[i]);
    if(emptyIdx === -1) return;
    filled[emptyIdx] = opt;
    render();
  }

  function clearBlank(idx){
    if(checked) return;
    delete filled[idx];
    render();
  }

  function checkAnswers(){
    checked = true;
    render();
  }

  function retryPage(){
    initPage();
  }

  function nextPage(){
    if(pageIndex < pages.length - 1){
      pageIndex++;
      initPage();
    } else {
      renderFinish();
    }
  }

  function renderFinish(){
    stopTimer();
    const root = document.getElementById('quiz-root');
    root.innerHTML = `
      <div class="finish-banner">
        <div class="big">✓ 全部練習完成！</div>
        <div class="small">您已完成 藥品保存與丟棄 相關練習。</div>
        <div class="timer-final">總耗時：${formatTime(elapsedSeconds)}</div>
        <a class="back-link" href="https://pha.lib.cmuh.org.tw/p/PHlearning">回藥劑部學習平台</a>
      </div>
    `;
  }

  function render(){
    const root = document.getElementById('quiz-root');
    const page = pages[pageIndex];
    const flatBlanks = getFlatBlanks(page);
    const allFilled = flatBlanks.every((b,i)=>filled[i]);
    const usedOptions = new Set(Object.values(filled));

    let blankGlobalIndex = 0;

    let groupsHtml = page.groups.map((g) => {
      let html = `<p class="sentence">`;
      g.segments.forEach(seg => {
        if(seg === "GAP"){
          const i = blankGlobalIndex;
          const blankInfo = flatBlanks[i];
          const val = filled[i];
          let cls = "blank ";
          let content = "&nbsp;";

          if(!val){
            cls += "blank-empty";
          } else if(!checked){
            cls += "blank-filled";
            content = val;
          } else {
            const isCorrect = val === blankInfo.answer;
            cls += isCorrect ? "blank-correct" : "blank-wrong";
            content = val + (isCorrect ? " ✓" : " ✗");
          }

          const clickAttr = !checked ? `onclick="window.__quiz.clearBlank(${i})"` : "";
          html += `<span class="${cls}" ${clickAttr}>${content}</span>`;
          blankGlobalIndex++;
        } else {
          html += seg;
        }
      });
      html += `</p>`;
      return html;
    }).join("");

    let optionsHtml = options.map(opt => {
      const used = usedOptions.has(opt);
      const disabled = used || checked;
      return `<button
        class="option-btn"
        onclick="window.__quiz.selectOption('${opt.replace(/'/g,"\\'")}')"
        ${disabled ? 'disabled' : ''}
        style="opacity:${used ? 0.35 : 1};"
      >${opt}</button>`;
    }).join("");

    let footer = "";
    if(checked){
      const allCorrect = flatBlanks.every((b,i)=>filled[i]===b.answer);
      if(allCorrect){
        const isLastPage = pageIndex === pages.length - 1;
        footer = `<div class="result-banner result-success">
          <span>✓ 所有答案都正確！非常好！</span>
          <button class="retry-btn" onclick="window.__quiz.nextPage()">${isLastPage ? '完成' : '下一頁'}</button>
        </div>`;
      } else {
        footer = `<div class="result-banner result-danger">
          <span>✗ 有答案不正確，請再試一次</span>
          <button class="retry-btn" onclick="window.__quiz.retryPage()">重新作答</button>
        </div>`;
      }
    } else {
      footer = `<button class="check-btn" onclick="window.__quiz.checkAnswers()" ${!allFilled ? 'disabled' : ''}>檢查</button>`;
    }

    root.innerHTML = `
      <h2 class="page-title">${page.title}</h2>
      <p class="progress">第 ${pageIndex + 1} / ${pages.length} 頁</p>
      <p class="timer" id="quiz-timer">已花費時間：${formatTime(elapsedSeconds)}</p>
      <div>${groupsHtml}</div>
      <div class="options-row">${optionsHtml}</div>
      <div class="footer-row">${footer}</div>
    `;
  }

  window.__quiz = { selectOption, clearBlank, checkAnswers, retryPage, nextPage };
  initPage();
})();
</script>

</body></html>
